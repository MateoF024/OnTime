{
  "schemaVersion": 1,
  "id": "ontime",
  "version": "${version}",
  "name": "OnTime",
  "description": "create custom timers with command execution capabilities. Perfect for minigames, events, or automated server tasks!",
  "authors": [
    "MateoF24"
  ],
  "license": "MIT",
  "icon": "assets/ontime/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.mateof24.OnTime"
    ],
    "client": [
      "com.mateof24.OnTimeClient"
    ]
  },
  "mixins": [
    "ontime.mixins.json",
    {
      "config": "ontime.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "${minecraft_range}",
    "java": "${java_requirement}",
    "fabric-api": "*"
  },
  "suggests": {
    "placeholder-api": "*"
  }
}